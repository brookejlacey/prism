# ============================================================
# Prism Protocol - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Deployer Wallet ---
# Private key for the deploying account (without 0x prefix is fine, ethers handles both)
PRIVATE_KEY=

# --- Polkadot Hub (Westend Asset Hub) ---
# RPC endpoint for the Westend Asset Hub EVM
# Default: https://westend-asset-hub-eth-rpc.polkadot.io
POLKADOT_HUB_RPC=https://westend-asset-hub-eth-rpc.polkadot.io

# --- Deployed Contract Addresses (populated by deploy-testnet.ts) ---
PVM_CORE_ADDRESS=
USDC_ADDRESS=
VAULT_ADDRESS=
ROUTER_ADDRESS=
BRIDGE_ADDRESS=

# --- Dashboard (Next.js) ---
# These are auto-written to packages/dashboard/.env.local by deploy-testnet.ts
NEXT_PUBLIC_PVM_CORE_ADDRESS=
NEXT_PUBLIC_ROUTER_ADDRESS=
NEXT_PUBLIC_BRIDGE_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=

# --- Optional: Additional relayer addresses (comma-separated) ---
# ADDITIONAL_RELAYERS=0x...,0x...
