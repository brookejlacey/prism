# ============================================================
# Prism - Environment Variables
# Copy to .env and fill in:  cp .env.example .env
# ============================================================

# --- Deployer wallet ---
# Private key for the deploying account (with or without 0x).
PRIVATE_KEY=

# --- Polkadot Hub testnet (PolkaVM EVM) ---
# RPC endpoint for the Polkadot Hub test network.
POLKADOT_HUB_RPC=https://testnet-passet-hub-eth-rpc.polkadot.io

# --- Deployed contract addresses (written by scripts/deploy.ts) ---
POSEIDON_ADDRESS=
VERIFIER_ADDRESS=
USDC_ADDRESS=
ROUTER_ADDRESS=
VAULT_ADDRESS=

# --- Dashboard (Next.js) ---
# Written to packages/dashboard/.env.local by deploy.ts.
NEXT_PUBLIC_ROUTER_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_VERIFIER_ADDRESS=
NEXT_PUBLIC_POSEIDON_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
